rules_version = '2';

// Jeder darf das laufende Turnier lesen (Live-Ansicht für Gäste), nur du darfst schreiben.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournament/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "DEINE_UID";
    }
  }
}
